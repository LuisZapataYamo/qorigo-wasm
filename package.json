{
  "name": "qorigo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "QoriGo - PWA local para gestión de suscripciones, préstamos y pagos",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
